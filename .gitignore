# =============================================================================
# WebMS Intra - .gitignore
# =============================================================================

# OS files
.DS_Store
Thumbs.db

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# Claude auto-memory symlink (local machine path, not portable)
#.claude/MEMORY.md

# Claude Code per-instance settings (enabled plugins etc — per-machine, not repo config)
.claude/settings.json

# Claude Code isolated agent worktrees (transient build sandboxes, never committed)
.claude/worktrees/
.claude/settings.local.json

# Secrets and credentials (NEVER commit these)
web/_auth_keys/
.env
*.key

# User uploads (server-managed, not committed)
web/_uploads/

# Backups (server-managed, not committed)
web/_backups/

# Self-hosted libraries (manually uploaded to server, not committed)
# dompdf etc. go in web/_libraries/ on the server
web/_libraries/

# Local asset fallbacks (downloaded from CDNs, placed locally for fallback).
# tools/download-cdn-fallbacks.sh fetches every one of these, and the
# installation package carries them (#499). The right-to-left stylesheet was
# missing from this list until 12 October 2026: Asset.php has always named it
# as a fallback, so a developer who ran the fetch script would otherwise have
# had it offered for commit.
web/public_html/assets/css/bootstrap.min.css
web/public_html/assets/css/bootstrap.rtl.min.css
web/public_html/assets/js/bootstrap.bundle.min.js
web/public_html/assets/css/fontawesome-all.min.css
web/public_html/assets/webfonts/

# Vendor libraries that should be manually managed
# (web/vendor/simplejwt/ IS committed as it's our own code)

# Logs
*.log
error_log

# PHP
*.php.bak

# Python leaves these behind when a script under tools/ is compiled or
# imported (for example `python3 -m py_compile tools/package/check-package.py`).
__pycache__/
