# =============================================================================
# Portal Front Controller - URL Rewriting + Hardening
# =============================================================================
# Rewrites all requests to index.php (the front controller) unless the request
# matches a static asset. This enables clean URLs like /expenses/submit
# instead of /expenses/submit/index.php.
#
# SECURITY: Direct access to .php files anywhere under public_html/ is BLOCKED
# (returns 404). The only entry points that may execute PHP via direct URL are
# /index.php (the front controller itself), /api-docs/ (Swagger UI viewer,
# served via Apache's DirectoryIndex), and /error.php (Apache ErrorDocument
# target — must remain externally reachable as Apache invokes it for 4xx/5xx
# subrequests). Every APP page lives in web/_apps/ outside the webroot
# entirely after #159 and is reached via the front-controller → Router →
# tblRoutes pipeline.
#
# WHAT IS ACTUALLY IN THIS FOLDER, because the three-file story below used to
# be written as though nothing else were here: the webroot holds EIGHT .php
# files, not three. The five that are not entry points — robots.php,
# sitemap.php, manifest.php, openapi.php and offline/index.php — are 404'd by
# the deny rule like any other, and are reached only through the router, by
# the clean addresses seeded in tblRoutes (robots.txt → robots.php,
# sitemap.xml → sitemap.php, manifest.json → manifest.php,
# openapi.json → openapi.php; Router.php includes offline/index.php itself for
# the 'offline' address). So the deny rule's exception list is NOT a list of
# what is in the folder, and a new file put here does NOT belong on it: give
# it a route instead. Do not "tidy away" one of those five on the strength of
# a comment saying only three files live here — each one answers a live
# address.
#
# This means a probe like "/expenses/submit/save.php" returns 404 — no leak of
# the backend language, no way to bypass the router's auth + CSRF gates by
# hitting handler files directly.
#
# @see https://httpd.apache.org/docs/2.4/mod/mod_rewrite.html
# @see https://owasp.org/www-community/Security_by_Design_Principles
# =============================================================================

RewriteEngine On
RewriteBase /

# 🔒 Block access to hidden files (e.g. .htaccess, .git, .env)
RewriteCond %{REQUEST_URI} (^|/)\.(?!well-known) [NC]
RewriteRule ^ - [F]

# 🪞 Redirect direct /index.php requests to /.
#     %{THE_REQUEST} reads the ORIGINAL HTTP request line, so this only
#     fires on real external visits to /index.php — it does NOT fire on
#     Apache's internal rewrites from clean URLs (e.g. /expenses/submit
#     -> index.php) because those don't change THE_REQUEST.
RewriteCond %{THE_REQUEST} ^(GET|POST|HEAD)\s/index\.php[\s?]
RewriteRule ^index\.php$ / [R=301,L]

# 🛡️ Deny direct access to ANY .php file except the three known entry points.
#     Order matters: this MUST run before the existing-file pass-through
#     below, otherwise Apache would serve the .php file directly.
#       /index.php           — front controller (rewrite target)
#       /api-docs/index.php  — Swagger UI bundle (DirectoryIndex)
#       /error.php           — Apache ErrorDocument target
#     After #159 every app controller lives in web/_apps/ outside the webroot
#     entirely. NOTE: this is a list of the three addresses Apache may EXECUTE
#     directly, not a list of the .php files in this folder — there are eight
#     of them, and the other five are meant to be 404'd here and reached
#     through the router instead. See the header for which, and why adding a
#     file here never means adding a line to this list.
RewriteCond %{REQUEST_URI} \.php$
RewriteCond %{REQUEST_URI} !^/index\.php$
RewriteCond %{REQUEST_URI} !^/api-docs/index\.php$
RewriteCond %{REQUEST_URI} !^/error\.php$
RewriteRule .* - [R=404,L]

# 🏷️ Asset Tracker app route (#393). The bare `/assets` URL collides with
#     the physical static `assets/` directory (css/js/images/fonts/vendor)
#     below — the `!-d` check two rules down would resolve `/assets` to
#     that directory's listing/index rather than the front controller, so
#     the Asset Tracker's own register page would never be reachable. This
#     rule intercepts ONLY the exact bare path (with or without a trailing
#     slash) and sends it to index.php before the static-file/-dir checks
#     run. Deep links like `/assets/item` are untouched — they don't match
#     `^assets/?$` and fall through to the normal rewrite below.
RewriteRule ^assets/?$ index.php [QSA,L]

# 📁 Skip rewriting for existing static files (CSS, JS, images, fonts,
#     /robots.txt, /openapi.json, /manifest.json, /sw.js, etc.)
RewriteCond %{REQUEST_FILENAME} !-f

# 📂 Skip rewriting for existing directories (so /api-docs/ resolves to its
#     DirectoryIndex /api-docs/index.php correctly)
RewriteCond %{REQUEST_FILENAME} !-d

# 🎯 Route everything else through the front controller
RewriteRule ^(.*)$ index.php [QSA,L]

# 🪞 Apache-level error documents. The front controller renders themed pages
#     for errors caught inside PHP via Router::renderError(), but errors that
#     happen BEFORE PHP starts (or that Apache produces directly — e.g.
#     denied filesystem permissions on a protected dir, mod_security blocks)
#     would otherwise show server-default pages that leak the Apache version
#     and a sterile error message.
#
#     Route each through error.php which delegates to the same themed templates.
ErrorDocument 403 /error.php?code=403
ErrorDocument 404 /error.php?code=404
ErrorDocument 500 /error.php?code=500
ErrorDocument 503 /error.php?code=503

# 🏷️ Brand response headers.
#     X-Powered-By is set by PHP in bootstrap.php to "WebMS-Intra/<version>"
#     (replacing PHP's default "PHP/8.x.y"). Apache must NOT unset it here,
#     or our branded value would be stripped along with the default.
#     The Server header is still stripped — it leaks the Apache version.
<IfModule mod_headers.c>
    Header always unset Server
</IfModule>
