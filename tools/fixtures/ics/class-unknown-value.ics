DTEND;TZID=Europe/London:20261116T100000
CLASS:X-SECRET
SUMMARY:Unknown class value
END:VEVENT
BEGIN:VEVENT
UID:class-confidential-1@fixtures.webms.test
DTSTAMP:20260901T090000Z
DTSTART;TZID=Europe/London:20261116T110000
DTEND;TZID=Europe/London:20261116T120000
CLASS:CONFIDENTIAL
SUMMARY:Confidential
END:VEVENT
END:VCALENDAR
